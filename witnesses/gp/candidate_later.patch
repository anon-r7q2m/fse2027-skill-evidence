+
+    def test_inherited_explicit_pk_from_abstract_base(self):
+        class AbstractBase(models.Model):
+            id = models.BigAutoField(primary_key=True)
+
+            class Meta:
+                abstract = True
+
+        class Child(AbstractBase):
+            pass
+
+        # Child should inherit the explicit primary key from the abstract
+        # base and therefore should not trigger W042.
+        self.assertEqual(
+            checks.run_checks(app_configs=self.apps.get_app_configs()),
+            []
+        )
